{
  "name": "muse-code-desktop",
  "version": "0.7.0-beta.1",
  "private": true,
  "description": "Desktop client for Muse Code that uses the user's existing Muse Code subscription via muse login.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
    "build:renderer": "npm run typecheck && vite build",
    "build": "npm run build:renderer && electron-builder",
    "build:win": "npm run build:renderer && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/host.test.cjs tests/protocol.test.cjs tests/native-terminal.test.cjs tests/desktop-engine.test.cjs tests/renderer-security.test.cjs tests/update-checker.test.cjs",
    "test:ui": "playwright test",
    "format": "prettier --write src electron tests README.md package.json .github/workflows/windows-build.yml",
    "test:electron": "node tests/electron-smoke.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@muse-code/sdk": "0.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.13.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "site.lunada.musedesktop",
    "productName": "Muse Desktop",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Muse-Desktop-${version}-Windows-${arch}.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "author": "Muse Desktop"
}
